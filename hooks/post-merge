#!/bin/bash
#
# Git runs this after a merge, including a fast-forward `git pull`. Its exit code does not undo the merge.
# All logic lives in scripts/post-merge.sh. This file only forwards the arguments and stdin.
# https://git-scm.com/docs/githooks#_post_merge
#
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$hook_dir/../scripts/post-merge.sh" "$@"
