#!/bin/bash
#
# Git runs this before it pushes. A non-zero exit blocks the push.
# Skip with: git push --no-verify
# All logic lives in scripts/pre-push.sh. This file only forwards the arguments and stdin.
# https://git-scm.com/docs/githooks#_pre_push
#
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$hook_dir/../scripts/pre-push.sh" "$@"
