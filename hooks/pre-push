#!/bin/bash
#
# Git runs this before it pushes. A non-zero exit blocks the push.
# Stdin: one line per pushed ref (<local ref> <local sha> <remote ref> <remote sha>).
# Runs scripts/detect-push-without-tests.sh, then the repo's own .git/hooks/pre-push, if present.
# Skip with: git push --no-verify
#
set -euo pipefail

PWD="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Git passes the pushed refs on stdin. Both hooks need them.
pushed_refs="$(cat)"

bash "$PWD/../scripts/detect-push-without-tests.sh" <<< "$pushed_refs"
bash "$PWD/../scripts/run-local-hook.sh" pre-push "$@" <<< "$pushed_refs"
