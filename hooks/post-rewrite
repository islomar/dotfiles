#!/bin/bash
#
# Git runs this after `git commit --amend` and `git rebase`. Its exit code does not undo the rewrite.
# All logic lives in scripts/post-rewrite.sh. This file only forwards the arguments and stdin.
# https://git-scm.com/docs/githooks#_post_rewrite
#
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$hook_dir/../scripts/post-rewrite.sh" "$@"
