#!/bin/bash
#
# Git runs this before it creates a commit. A non-zero exit blocks the commit.
# Skip with: git commit --no-verify
# All logic lives in scripts/pre-commit.sh. This file only forwards the arguments and stdin.
# https://git-scm.com/docs/githooks#_pre_commit
#
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$hook_dir/../scripts/pre-commit.sh" "$@"
