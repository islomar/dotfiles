+    def _play_finish_sound(self) -> None:
+        """Play the finish sound once, without blocking the deck."""
+        settings = self.get_settings()
+        if not settings.get("sound_enabled", True):
+            return
+        sound_path = os.path.expanduser(settings.get("sound_path", DEFAULT_SOUND_PATH))
+        if not os.path.isfile(sound_path):
+            return
+        try:
+            subprocess.Popen(["paplay", sound_path],
+                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        except OSError:
+            pass
