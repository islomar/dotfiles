#!/usr/bin/env bash
# Password-protected folders with gocryptfs. One shared password, stored in 1Password.
#
# Usage:
#   encrypted-folders unlock [folder…]  Unlock the given protected folders, or all of them (1Password asks for approval)
#   encrypted-folders lock [folder…]    Lock the given protected folders, or all of them
#   encrypted-folders status            Show which folders are locked or unlocked
#   encrypted-folders toggle            Lock all if any folder is unlocked, otherwise unlock all, and notify
#   encrypted-folders deck              Print a short state label for a Stream Deck key
#   encrypted-folders protect <folder>  Encrypt <folder> in place and add it to the list
#
# Each protected folder <parent>/<name> keeps its path. Its encrypted data lives next to it in
# <parent>/.<name>.gocryptfs. While locked, the folder is an empty mount point.
# Unlocked folders lock themselves after $IDLE without use.
# status and unlock warn when a locked folder holds files saved while it was locked (they are not
# encrypted); unlock refuses to mount over them.
# status and unlock tell a broken mount apart from a missing folder: a folder renamed or moved
# while unlocked, or one whose gocryptfs process died, and print the command that clears it.
#
# Personal settings live outside this repository, in ~/.config/encrypted-folders/:
#   config   OP_REF="op://<vault>/<item>/password"  and optionally IDLE="15m"
#   folders  one absolute folder path per line
# Requires: gocryptfs, fusermount3, rsync, 1Password CLI (op) with desktop app integration.

set -uo pipefail

CONF_DIR="$HOME/.config/encrypted-folders"
LIST="$CONF_DIR/folders"
IDLE="15m"
# shellcheck source=/dev/null
[ -f "$CONF_DIR/config" ] && source "$CONF_DIR/config"
: "${OP_REF:?Set OP_REF in $CONF_DIR/config}"
[ -f "$LIST" ] || touch "$LIST"
TOGGLE_LOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/encrypted-folders.toggle.lock"

store_of() { echo "$(dirname "$1")/.$(basename "$1").gocryptfs"; }

# Write the password to a RAM-only file readable by the current user, and remove it on exit.
make_passfile() {
  PASSFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/encrypted-folders.$$"
  (umask 077; op read "$OP_REF" | tr -d '\n' > "$PASSFILE") || { echo "Could not read the password from 1Password." >&2; exit 1; }
  trap 'shred -u "$PASSFILE" 2>/dev/null; rm -f "$PASSFILE"' EXIT
}

# Print the folders to act on: the arguments (resolved to their real path, so links such as
# /mnt/data work), or every listed folder when there are no arguments. Exits if an argument
# is not a protected folder.
selected_folders() {
  if [ $# -eq 0 ]; then grep -v '^$' "$LIST"; return; fi
  local a r
  for a in "$@"; do
    r="$(realpath -m "$a")"
    grep -qxF "$r" "$LIST" || { echo "Not a protected folder: $a" >&2; echo "See: encrypted-folders status" >&2; exit 1; }
    echo "$r"
  done
}

# A locked folder is an empty mount point. Anything inside it was saved while the folder was
# locked: it is NOT encrypted, and unlocking would hide it under the encrypted contents.
stray_count() { find "$1" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l; }

stray_warning() {
  echo "WARNING: $1 is locked but holds $2 unencrypted item(s), saved while it was locked." >&2
  echo "  They are readable without the password. To fix: move them out, unlock the folder," >&2
  echo "  move them back in, then lock it again." >&2
}

# Print the mount point of a gocryptfs mount that belongs to folder $1: mounted at $1, or mounted
# from its encrypted store (the folder was renamed or moved while unlocked, so it now sits at a
# new path). Reads only the kernel's mount table, so it never touches the mounted folders.
# mountinfo fields: ... <mount point> <options> [optional fields] - <type> <source> <options>
gocryptfs_mount_of() {
  awk -v want_mp="$1" -v want_src="$(store_of "$1")" '
    function unescape(s) {
      gsub(/\\040/, " ", s); gsub(/\\011/, "\t", s); gsub(/\\012/, "\n", s); gsub(/\\134/, "\\", s)
      return s
    }
    {
      for (i = 7; i <= NF && $i != "-"; i++) ;
      if ($(i + 1) != "fuse.gocryptfs") next
      mp = unescape($5); src = unescape($(i + 2))
      if (mp == want_mp || src == want_src) { print mp; exit }
    }' /proc/self/mountinfo
}

# Explain a listed folder that cannot be read: a broken mount, or a folder that is really gone.
missing_message() {
  local mp; mp="$(gocryptfs_mount_of "$1")"
  if [ -z "$mp" ]; then
    echo "MISSING   $1 (moved or renamed? Fix the path in $LIST)"
  elif [ "$mp" = "$1" ]; then
    echo "BROKEN    $1 (its gocryptfs process stopped. Run: fusermount3 -u '$mp', then unlock)"
  else
    echo "BROKEN    $1 (renamed or moved while unlocked, now at '$mp'."
    echo "          Run: fusermount3 -u '$mp', fix the path in $LIST, then unlock)"
  fi
}

cmd_unlock() {
  local targets; targets="$(selected_folders "$@")" || exit 1
  make_passfile
  local ok=0 fail=0 m n
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    if mountpoint -q "$m"; then ok=$((ok + 1)); continue; fi
    if [ ! -d "$m" ]; then missing_message "$m" >&2; fail=$((fail + 1)); continue; fi
    n=$(stray_count "$m")
    if [ "$n" -gt 0 ]; then
      stray_warning "$m" "$n"
      echo "NOT UNLOCKED: $m" >&2; fail=$((fail + 1)); continue
    fi
    if gocryptfs -q -idle "$IDLE" -passfile "$PASSFILE" "$(store_of "$m")" "$m"; then
      ok=$((ok + 1))
    else
      echo "FAILED: $m" >&2; fail=$((fail + 1))
    fi
  done <<< "$targets"
  echo "Unlocked: $ok   Failed: $fail   (each folder locks itself after $IDLE idle)"
}

cmd_lock() {
  local targets; targets="$(selected_folders "$@")" || exit 1
  local busy=0 m
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    mountpoint -q "$m" || continue
    fusermount3 -u "$m" 2>/dev/null || { echo "IN USE (close files or terminals there): $m" >&2; busy=$((busy + 1)); }
  done <<< "$targets"
  echo "Locked. Still open because in use: $busy"
}

cmd_status() {
  local m n
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    if [ ! -d "$m" ]; then
      missing_message "$m"
    elif mountpoint -q "$m"; then
      echo "UNLOCKED  $m"
    else
      n=$(stray_count "$m")
      if [ "$n" -gt 0 ]; then
        echo "locked, $n UNENCRYPTED item(s) inside  $m"
        stray_warning "$m" "$n"
      else
        echo "locked    $m"
      fi
    fi
  done < "$LIST"
}

# Count unlocked folders from the kernel's mount table. This never touches the mounted folders:
# polling them could count as use and stop the idle auto-lock. Mount paths encode spaces as \040.
mounted_count() {
  awk 'NR == FNR { if ($0 != "") listed[$0]; next }
       { path = $5; gsub(/\\040/, " ", path); if (path in listed) n++ }
       END { print n + 0 }' "$LIST" /proc/self/mountinfo
}

cmd_deck() {
  local total open
  flock -n "$TOGGLE_LOCK" true 2>/dev/null || { echo "Wait"; return; }
  total=$(grep -c . "$LIST")
  open=$(mounted_count)
  if [ "$open" -eq 0 ]; then echo "Locked"; else echo "Open $open/$total"; fi
}

notify() { notify-send -t 5000 -i "$1" "Encrypted folders" "$2"; }

# The notification shows counts only: it can appear on a shared screen, so it never names a folder.
toggle_now() {
  local out rc
  out="$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" encrypted-folders.XXXXXX)" || exit 1
  # Output goes to a file: a pipe could stay open in the gocryptfs background process.
  if [ "$(mounted_count)" -gt 0 ]; then
    ( cmd_lock ) > "$out" 2>&1; rc=$?
  else
    ( cmd_unlock ) > "$out" 2>&1; rc=$?
  fi
  if [ "$rc" -ne 0 ] || grep -qE 'Failed: [1-9]|in use: [1-9]' "$out"; then
    notify dialog-warning "$(tail -n 1 "$out") Run: encrypted-folders status"
  else
    notify changes-prevent "$(tail -n 1 "$out")"
  fi
  rm -f "$out"
}

# The transient systemd scope keeps gocryptfs alive when the caller's service stops. The Stream Deck
# app starts commands inside flatpak-session-helper.service. flock -o keeps the lock out of gocryptfs.
cmd_toggle() {
  local rc=0
  flock -n -o -E 75 "$TOGGLE_LOCK" \
    systemd-run --user --scope --collect --quiet -- "$(realpath "$0")" toggle-now || rc=$?
  if [ "$rc" -eq 75 ]; then notify dialog-information "Still working on the last press."; fi
}

# Encrypt a folder in place. The original is deleted only after every file in the encrypted
# copy is byte-identical and survives a lock/unlock cycle. Any failure restores the original.
cmd_protect() {
  local M; M="$(realpath -e "${1:?Usage: encrypted-folders protect <folder>}")" || exit 1
  local N; N="$(basename "$M")"
  local C; C="$(store_of "$M")"
  local T; T="$(dirname "$M")/.$N.plain-migrating"
  log() { echo "[$(date +%T)] $N: $*"; }
  rollback() {
    log "ROLLBACK: $1"
    mountpoint -q "$M" && fusermount3 -u "$M"
    if [ -d "$T" ]; then
      rmdir "$M" 2>/dev/null || mv "$M" "$M.failed-$$"
      mv "$T" "$M"
    fi
    rm -rf "$C"
    exit 1
  }

  [ -d "$M" ] || { log "not a directory"; exit 1; }
  grep -qxF "$M" "$LIST" && { log "already protected"; exit 1; }
  { [ -e "$C" ] || [ -e "$T" ]; } && { log "$C or $T already exists"; exit 1; }
  mountpoint -q "$M" && { log "already a mount point"; exit 1; }

  make_passfile
  local n1 n2 n3 diffs
  n1=$(find "$M" -type f | wc -l)
  log "start: $n1 files, $(du -sh "$M" | cut -f1)"
  mv "$M" "$T" || exit 1
  mkdir "$C" "$M" || rollback "mkdir"
  chmod 700 "$C"
  gocryptfs -init -q -passfile "$PASSFILE" "$C" > /dev/null || rollback "init"
  gocryptfs -q -passfile "$PASSFILE" "$C" "$M" || rollback "mount"
  rsync -aHAX "$T"/ "$M"/ || rollback "copy"
  log "copied, verifying byte by byte"
  diffs=$(rsync -aHAXnci --delete "$T"/ "$M"/ | grep -v '^\.d' | head -5)
  [ -z "$diffs" ] || rollback "content differs: $diffs"
  n2=$(find "$M" -type f | wc -l)
  [ "$n2" -eq "$n1" ] || rollback "file count $n2 != $n1"
  fusermount3 -u "$M" || rollback "lock"
  [ -z "$(ls -A "$M")" ] || rollback "folder not empty after lock"
  gocryptfs -q -passfile "$PASSFILE" "$C" "$M" || rollback "unlock test"
  n3=$(find "$M" -type f | wc -l)
  fusermount3 -u "$M" || rollback "lock after test"
  [ "$n3" -eq "$n1" ] || rollback "after unlock test $n3 != $n1"
  rm -rf "$T"
  echo "$M" >> "$LIST"
  log "DONE: $n1 files encrypted and verified; unencrypted copy removed; folder is locked"
  echo "Remember to exclude '$M' (not its .gocryptfs store) from backup tools." >&2
}

case "${1:-}" in
  unlock) shift; cmd_unlock "$@" ;;
  lock) shift; cmd_lock "$@" ;;
  status) cmd_status ;;
  toggle) cmd_toggle ;;
  toggle-now) toggle_now ;;
  deck) cmd_deck ;;
  protect) shift; cmd_protect "$@" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
